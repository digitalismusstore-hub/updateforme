{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "updateforme",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "39b12018-8792-437e-9c83-2bd2ce196c3c","database_name": "updateforme" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5e60527a1fce4980980ef02076805990" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
